# .env.example
# Optional Google Search Console verification code (from the HTML Tag method)
# e.g., abc123456789xyz
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ==============================================================================
# STRIPE CONNECT & BILLING INTEGRATION CONFIGURATION
# ==============================================================================
# Stripe Secret API Key (from Stripe Dashboard > Developers > API keys)
# Format: sk_test_... or sk_live_...
STRIPE_SECRET_KEY=

# Stripe Webhook Signing Secret for standard subscription & billing snapshot events
# Format: whsec_...
STRIPE_WEBHOOK_SECRET=

# Stripe Webhook Signing Secret for thin account v2 events
# Format: whsec_...
STRIPE_THIN_WEBHOOK_SECRET=

# Platform Subscription Price ID (e.g. price_1234567890) for charging subscriptions to Connected Accounts
STRIPE_PRICE_ID=

# Base URL of your deployed application or local environment (e.g. https://your-domain.com or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
