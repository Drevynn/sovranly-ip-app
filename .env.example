# .env.example
APP_URL="https://sovranlyip.com"
GEMINI_API_KEY=

# Firebase Client Configuration (Optional fallbacks if firebase-applet-config.json is absent)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# =========================================================================
# Blockchain Mainnet Configurations (Zero-Trust Cryptographic Core)
# =========================================================================
# Secure private key of the deploying wallet address (DO NOT commit or expose)
DEPLOYER_PRIVATE_KEY=

# Mainnet RPC Provider Endpoints
MAINNET_RPC_URL="https://eth.llamarpc.com"
ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"
OPTIMISM_RPC_URL="https://mainnet.optimism.io"
BASE_RPC_URL="https://mainnet.base.org"
POLYGON_RPC_URL="https://polygon-rpc.com"

# Block Explorer API Keys for Smart Contract Source Code Verification
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISTIC_ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
POLYGONSCAN_API_KEY=
