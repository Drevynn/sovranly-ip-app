# .env.example
# Optional Google Search Console verification code (from the HTML Tag method)
# e.g., abc123456789xyz
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ==============================================================================
# PAYMENT PROVIDER & BILLING PORTAL CONFIGURATION (OPTIONAL)
# ==============================================================================
# Customer Billing Portal URL for subscription and invoice management
NEXT_PUBLIC_CUSTOMER_PORTAL_URL=

# Base URL of your deployed application or local environment (e.g. https://your-domain.com or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
