# .env.example
# Optional Google Search Console verification code (from the HTML Tag method)
# e.g., abc123456789xyz
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ==============================================================================
# UNIVERSAL PAY LINK & SOVEREIGN CHECKOUT CONFIGURATION
# ==============================================================================
# Optional custom direct Pay Links for platform subscription tiers
NEXT_PUBLIC_PAY_LINK_STARTER=
NEXT_PUBLIC_PAY_LINK_GROWTH=
NEXT_PUBLIC_PAY_LINK_ENTERPRISE=

# ==============================================================================
# LEGACY PAYMENT INTEGRATION CONFIGURATION (OPTIONAL)
# ==============================================================================
# Secret API Key (Optional / Legacy)
STRIPE_SECRET_KEY=

# Stripe Webhook Signing Secret for standard subscription & billing snapshot events
# Format: whsec_...
STRIPE_WEBHOOK_SECRET=

# Stripe Webhook Signing Secret for thin account v2 events
# Format: whsec_...
STRIPE_THIN_WEBHOOK_SECRET=

# Stripe Customer Billing Portal Configuration
# Portal Configuration ID (e.g. bpc_...)
STRIPE_PORTAL_CONFIGURATION_ID=
NEXT_PUBLIC_STRIPE_PORTAL_CONFIGURATION_ID=
# Direct Customer Billing Portal URL
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=

# Platform Subscription Price ID (e.g. price_1234567890) for charging subscriptions to Connected Accounts
STRIPE_PRICE_ID=

# Base URL of your deployed application or local environment (e.g. https://your-domain.com or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
