# .env.example — Sovranly IP Command Center
# Copy this file to .env.local and fill in your values.

# ─── Firebase (Client) ───
# Found in Firebase Console → Project Settings → Your Apps → Web App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sovranlyip.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sovranlyip
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sovranlyip.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: specify a named Firestore database ID (leave empty for default)
NEXT_PUBLIC_FIREBASE_DATABASE_ID=

# ─── Gemini AI ───
# Found in Google AI Studio → API Key
GEMINI_API_KEY=
# Optional: override the model name (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ─── App Configuration ───
NEXT_PUBLIC_APP_URL=https://www.sovranlyip.com
# Optional: Google Search Console verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Server-side Firebase Admin (for token verification) ───
# In production, set GOOGLE_APPLICATION_CREDENTIALS to the path of your
# service account JSON, or use Workload Identity Federation on Cloud Run.
# GOOGLE_APPLICATION_CREDENTIALS=
